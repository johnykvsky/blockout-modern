# ==========================================
# Build outputs and binaries
# ==========================================
bin/*
!bin/.gitkeep
obj/*
!obj/.gitkeep
build/
Build/
build-*/

# ==========================================
# Compiled object and library files
# ==========================================
*.o
*.obj
*.slo
*.lo
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.exe
*.app

# ==========================================
# Compiler dependencies and precompiled headers
# ==========================================
*.d
*.dwo
*.gch
*.pch

# ==========================================
# Debug symbols and build artifacts
# ==========================================
*.dSYM/
*.pdb
*.ilk
*.out

# ==========================================
# CMake / Language Server artifacts
# Note: Makefile is our actual source file, so it is NOT ignored!
# ==========================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
.cache/

# ==========================================
# Local runtime and log files
# ==========================================
highscore.txt
*.log
*.tmp
*.bak

# ==========================================
# Third-party dependencies
# Raylib is fetched via 'make deps'; only the directory structure is tracked
# ==========================================
third_party/raylib/*
!third_party/raylib/.gitkeep

# ==========================================
# Package managers
# ==========================================
vcpkg_installed/

# ==========================================
# Editor and OS temporary files
# ==========================================
.DS_Store
Thumbs.db
.directory
*~
*.swp
*.swo
*.kate-swp
.vscode/
.idea/
*.code-workspace

# ==========================================
# Language server and IDE cache
# ==========================================
.clangd/
CMakeUserPresets.json

# ==========================================
# Scripts and utility tools
# ==========================================
scripts/

# ==========================================
# Python bytecode and virtual environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
ENV/

# ==========================================
# Core dumps, profiling, and crash logs
# ==========================================
core
core.*
vgcore.*
gmon.out
*.gcda
*.gcno
*.gcov
screenshot*.png
*.orig
*.rej

