# ==========================================
# Build outputs and binaries
# ==========================================
bin/*
!bin/.gitkeep
obj/*
!obj/.gitkeep
build/
Build/
build-*/

# ==========================================
# Compiled object and library files
# ==========================================
*.o
*.obj
*.slo
*.lo
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.exe
*.app

# ==========================================
# Compiler dependencies and precompiled headers
# ==========================================
*.d
*.dwo
*.gch
*.pch

# ==========================================
# Debug symbols and build artifacts
# ==========================================
*.dSYM/
*.pdb
*.ilk
*.out

# ==========================================
# CMake / Language Server artifacts
# Note: Makefile is our actual source file, so it is NOT ignored!
# ==========================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
.cache/

# ==========================================
# Local runtime and log files
# ==========================================
highscore.txt
*.log
*.tmp
*.bak

# ==========================================
# Third-party dependencies
# Raylib is fetched via 'make deps'; only the directory structure is tracked
# ==========================================
third_party/raylib/*
!third_party/raylib/.gitkeep

# ==========================================
# Package managers
# ==========================================
vcpkg_installed/

# ==========================================
# Editor and OS temporary files
# ==========================================
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/
